  {
    "id": "hbl-outing-3",
    "title": "最后的决定",
    "level": "入门",
    "rubricVersion": "1",
    "source": {
      "name": "Storybooks HamBaangLaang · 出街玩",
      "url": "https://global-asp.github.io/storybooks-hbl/stories/yue/00001/",
