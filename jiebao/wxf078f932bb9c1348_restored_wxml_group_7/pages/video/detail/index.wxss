page {
    background-color: #f8f9fa;
    flex-direction: column;
    height: 100%;
}

.container,page {
    display: -webkit-flex;
    display: flex;
}

.container {
    box-sizing: border-box;
    flex: 1;
    flex-direction: column;
    overflow: auto;
}

.article {
    flex: 1;
    height: 100%;
    overflow: scroll;
}

.content {
    color: #1a1a1a;
    line-height: 1.8;
}

.article-head {
    border-bottom: 2rpx solid rgba(15,23,42,.06);
    margin: 0 24rpx 24rpx;
    padding: 8rpx 4rpx 18rpx;
}

.article-head__title {
    color: #111827;
    font-size: 40rpx;
    font-weight: 700;
    line-height: 1.45;
    word-break: break-word;
}

.paragraph {
    border-left: 4rpx solid transparent;
    color: #1a1a1a;
    font-family: "Source Han Serif CN",serif;
    font-size: 40rpx;
    font-weight: 400;
    letter-spacing: 1rpx;
    line-height: 2.6;
    margin-bottom: 32rpx;
    padding: 20rpx 28rpx;
    position: relative;
    text-align: left;
    transition: all .3s ease;
}

.paragraph:last-child {
    margin-bottom: 0;
}

.paragraph:not(:last-child)::after {
    background: linear-gradient(90deg,transparent,rgba(0,0,0,.05),transparent);
    border-radius: 999rpx;
    bottom: -12rpx;
    content: "";
    height: 2rpx;
    left: 24rpx;
    position: absolute;
    right: 24rpx;
}

.active {
    background: #f4f7ff;
    border-left: 4rpx solid #597ef7;
    box-shadow: 0 4rpx 16rpx rgba(30,60,160,.08);
    color: #151515;
    font-weight: 500;
}

.paragraph--compact {
    line-height: 2.25;
    margin-bottom: 24rpx;
    padding: 16rpx 24rpx;
}

.paragraph--compact:not(:last-child)::after {
    bottom: -8rpx;
}

.bottom-player-bar {
    background: #fff;
    border-top: 1rpx solid #f0f0f0;
    bottom: 0;
    box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.08);
    justify-content: space-between;
    left: 0;
    padding: 24rpx 32rpx;
    position: fixed;
    right: 0;
    z-index: 100;
}

.bottom-player-bar,.player-controls {
    align-items: center;
    display: -webkit-flex;
    display: flex;
}

.player-controls {
    flex: 1;
    gap: 24rpx;
}

.play-btn {
    align-items: center;
    background: #f8f9fa;
    border-radius: 50%;
    display: -webkit-flex;
    display: flex;
    height: 80rpx;
    justify-content: center;
    transition: all .3s ease;
    width: 80rpx;
}

.play-btn:active {
    background: #e9ecef;
    transform: scale(.95);
}

.play-info {
    flex: 1;
    flex-direction: column;
}

.play-count,.play-info {
    display: -webkit-flex;
    display: flex;
    gap: 8rpx;
}

.play-count {
    align-items: center;
}

.play-count,.play-count text {
    color: #999;
    font-size: 24rpx;
}

.duration {
    color: #333;
    font-size: 28rpx;
    font-weight: 500;
}

.action-buttons {
    gap: 32rpx;
}

.action-btn,.action-buttons {
    display: -webkit-flex;
    display: flex;
}

.action-btn {
    align-items: center;
    border-radius: 8rpx;
    flex-direction: column;
    gap: 10rpx;
    padding: 8rpx;
    transition: all .3s ease;
}

.action-btn:active {
    background: #f8f9fa;
    transform: scale(.95);
}

.action-text {
    color: #666;
    font-size: 20rpx;
}

.reset-btn {
    background-color: initial;
    border-radius: 0;
    line-height: inherit;
    margin: 0;
    padding: 0;
}

.reset-btn::after {
    border: none;
}

.setting-container {
    padding: 20rpx;
}

.setting-item {
    align-items: center;
    border-bottom: 1rpx solid #efefef;
    display: -webkit-flex;
    display: flex;
    justify-content: space-between;
    padding-bottom: 20rpx;
    padding-top: 20rpx;
}

.setting-item .desc {
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
}

.setting-item .desc text:first-child {
    font-size: 30rpx;
    font-weight: 700;
}

.setting-item .desc text:last-child {
    font-size: 24rpx;
}

.section {
    overflow: hidden;
    padding-top: 56.25%;
    position: relative;
}

.section,.video-player {
    background-color: #000;
    width: 100%;
}

.video-player {
    display: block;
    height: 100%;
    left: 0;
    position: absolute;
    top: 0;
}

.video-placeholder {
    align-items: center;
    background: rgba(0,0,0,.6);
    color: #c1c7d0;
    font-size: 28rpx;
    inset: 0;
    justify-content: center;
    position: absolute;
}

.tag-list,.video-placeholder {
    display: -webkit-flex;
    display: flex;
}

.tag-list {
    flex-wrap: wrap;
    gap: 10rpx;
    margin: 16rpx 24rpx 0;
}

.tag-chip {
    background: rgba(89,126,247,.12);
    color: #1a3a91;
    padding: 4rpx 14rpx;
}

.audio-only-chip,.tag-chip {
    border-radius: 999rpx;
    font-size: 24rpx;
}

.audio-only-chip {
    background: rgba(89,126,247,.9);
    color: #fff;
    left: 24rpx;
    padding: 6rpx 20rpx;
    position: absolute;
    top: 24rpx;
    z-index: 10;
}

.article-empty {
    color: #9ea3b0;
    font-size: 28rpx;
    padding: 80rpx 24rpx;
    text-align: center;
}

.episode-inline {
    align-items: center;
    border-bottom: 1rpx dashed #e2e8f0;
    display: -webkit-flex;
    display: flex;
    gap: 12rpx;
    margin: 16rpx 24rpx 0;
    padding-bottom: 12rpx;
}

.episode-inline__title {
    color: #1f2a37;
    font-size: 30rpx;
    font-weight: 600;
}

.episode-inline__count {
    color: #6b7280;
    font-size: 24rpx;
}

.episode-popup {
    backdrop-filter: blur(12rpx);
    background: hsla(0,0%,100%,.9);
    box-sizing: border-box;
    min-height: 100vh;
    padding: 48rpx 32rpx;
    width: 70vw;
}

.episode-popup__header {
    align-items: flex-start;
    display: -webkit-flex;
    display: flex;
    justify-content: space-between;
    margin-bottom: 24rpx;
}

.episode-popup__title {
    color: #111827;
    font-size: 34rpx;
    font-weight: 600;
}

.episode-popup__subtitle {
    display: block;
    margin-top: 4rpx;
}

.episode-popup__count,.episode-popup__subtitle {
    color: #6b7280;
    font-size: 24rpx;
}

.episode-popup__list {
    max-height: calc(100vh - 180rpx);
}

.episode-card {
    background: hsla(0,0%,100%,.95);
    border: 1rpx solid rgba(226,232,240,.9);
    border-radius: 18rpx;
    box-shadow: 0 4rpx 14rpx rgba(15,23,42,.06);
    padding: 22rpx 28rpx;
    transition: all .2s ease;
}

.episode-card--active {
    background: linear-gradient(135deg,rgba(89,126,247,.12),hsla(0,0%,100%,.9));
    border-color: rgba(89,126,247,.6);
    box-shadow: 0 10rpx 20rpx rgba(89,126,247,.25);
}

.episode-card__title {
    color: #101828;
    font-size: 32rpx;
    font-weight: 600;
}

.episode-card__meta {
    color: #5b6472;
    display: -webkit-flex;
    display: flex;
    font-size: 24rpx;
    gap: 16rpx;
    margin-top: 12rpx;
}

.episode-card__badge {
    background: rgba(72,201,145,.2);
    border-radius: 999rpx;
    color: #118a4d;
    padding: 2rpx 10rpx;
}

.action-menu {
    bottom: 120rpx;
    position: fixed;
    right: 24rpx;
    z-index: 120;
}

.action-menu,.action-menu__list {
    align-items: flex-end;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.action-menu__item {
    align-items: center;
    background: rgba(21,31,42,.9);
    border-radius: 999rpx;
    box-shadow: 0 16rpx 32rpx rgba(21,31,42,.25);
    color: #fff;
    display: -webkit-flex;
    display: flex;
    font-size: 24rpx;
    gap: 12rpx;
    line-height: 1.2;
    padding: 16rpx 22rpx;
}

.action-menu__item--pill {
    justify-content: space-between;
    min-width: 200rpx;
}

.action-menu__item-info {
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
}

.action-menu__item-title {
    font-weight: 500;
}

.action-menu__item-desc {
    font-size: 22rpx;
    opacity: .85;
}

.action-toggle {
    align-items: center;
    background: rgba(15,155,142,.9);
    border-radius: 50%;
    box-shadow: 0 12rpx 30rpx rgba(12,109,132,.35);
    display: -webkit-flex;
    display: flex;
    height: 86rpx;
    justify-content: center;
    width: 86rpx;
}

.loop-indicator__wrapper {
    align-items: flex-end;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.loop-indicator__content {
    align-items: center;
    background: rgba(21,31,42,.95);
    border-radius: 999rpx;
    box-shadow: 0 12rpx 28rpx rgba(21,31,42,.2);
    color: #fff;
    display: -webkit-flex;
    display: flex;
    gap: 16rpx;
    padding: 14rpx 20rpx;
}

.loop-indicator__info {
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
}

.loop-indicator__title {
    font-size: 24rpx;
    font-weight: 500;
}

.loop-indicator__desc {
    font-size: 20rpx;
    opacity: .8;
}

.settings-panel {
    padding: 32rpx 32rpx 60rpx;
}

.settings-panel__title {
    color: #1a1a1a;
    font-size: 32rpx;
    font-weight: 600;
    margin-bottom: 20rpx;
}

.settings-item {
    align-items: center;
    border-bottom: 1rpx solid #f3f3f3;
    display: -webkit-flex;
    display: flex;
    justify-content: space-between;
    padding: 20rpx 0;
}

.settings-item:last-child {
    border-bottom: none;
}

.settings-item__text {
    color: #2c2c2c;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    gap: 6rpx;
}

.settings-item__title {
    font-size: 30rpx;
    font-weight: 500;
}

.settings-item__desc {
    color: #7a7a7a;
    font-size: 24rpx;
}

.zimu {
    background: rgba(0,0,0,.05);
    color: #fff;
    font-size: 30rpx;
    left: 10rpx;
    position: absolute;
    top: 200rpx;
    z-index: 100;
}

.mandarin {
    color: #5f6368;
    font-size: 28rpx;
    line-height: 1.8;
    margin-top: 12rpx;
}

