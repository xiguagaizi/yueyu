.container {
    background: #f8f9fd;
    min-height: 100vh;
    padding: 30rpx;
}

.word-header {
    margin: 40rpx 0 60rpx;
}

.word-main {
    gap: 20rpx;
}

.audio-card,.word-main {
    align-items: center;
}

.audio-card {
    background: #cae1ff;
    border-radius: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(91,114,235,.08);
    justify-content: space-between;
    margin-bottom: 48rpx;
    padding: 40rpx;
}

.audio-card,.audio-text {
    display: -webkit-flex;
    display: flex;
}

.audio-text {
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16rpx 12rpx;
}

.audio-ruby-item {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    justify-content: center;
}

.audio-title {
    color: #5b72eb;
    font-size: 36rpx;
    font-weight: 500;
}

.audio-desc {
    color: #999;
    font-size: 28rpx;
}

.section {
    margin-bottom: 48rpx;
}

.section-title {
    align-items: center;
    gap: 16rpx;
    margin-bottom: 24rpx;
}

.content-card {
    box-shadow: 0 4rpx 16rpx rgba(91,114,235,.08);
}

.meaning-text {
    color: #333;
    font-size: 32rpx;
    line-height: 1.6;
}

.example-list {
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    gap: 24rpx;
}

.example-item {
    box-shadow: 0 4rpx 16rpx rgba(91,114,235,.08);
}

.example-header {
    justify-content: space-between;
    margin-bottom: 16rpx;
}

.cantonese,.example-header {
    align-items: center;
    display: -webkit-flex;
    display: flex;
}

.cantonese {
    color: #333;
    font-size: 36rpx;
    font-size: 32rpx;
    font-weight: 500;
}

.icon-wrap {
    height: 50rpx;
    width: 50rpx;
}

.translation {
    color: #666;
    display: -webkit-flex;
    display: flex;
    font-size: 28rpx;
}

.custom-nav {
--nav-bar-background-color:#f8f9fd;--nav-bar-text-color:#333;--nav-bar-icon-color:#7b6754}

.app-name {
    font-size: 36rpx;
}

.app-name,.word-text {
    color: #333;
    font-weight: 600;
}

.word-text {
    display: block;
    font-size: 72rpx;
}

.pinyin {
    color: #666;
    display: block;
    font-size: 48rpx;
    margin-top: 16rpx;
}

.pronunciation-section {
    background: #fff;
    border-radius: 24rpx;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    margin-bottom: 40rpx;
    padding: 40rpx;
    position: relative;
}

.play-text {
    color: #4080ff;
    font-size: 36rpx;
    margin-bottom: 8rpx;
}

.play-desc {
    color: #999;
    font-size: 28rpx;
}

.play-btn {
    align-items: center;
    background: #4080ff;
    border-radius: 50%;
    display: -webkit-flex;
    display: flex;
    height: 100rpx;
    justify-content: center;
    position: absolute;
    right: 40rpx;
    top: 50%;
    transform: translateY(-50%);
    width: 100rpx;
}

.section {
    margin-bottom: 40rpx;
}

.section-header {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    margin-bottom: 24rpx;
}

.section-icon {
    height: 40rpx;
    margin-right: 16rpx;
    width: 40rpx;
}

.section-title {
    color: #333;
    display: -webkit-flex;
    display: flex;
    font-size: 36rpx;
    font-weight: 500;
    gap: 5rpx;
    padding: 20rpx 20rpx 20rpx 0;
}

.content-card {
    color: #333;
    line-height: 150%;
}

.content-card,.example-item {
    background: #fff;
    border-radius: 24rpx;
    padding: 32rpx;
}

.example-item {
    align-items: flex-start;
    display: -webkit-flex;
    display: flex;
    justify-content: flex-start;
}

.example-audio {
    margin-right: 24rpx;
}

.audio-icon {
    height: 48rpx;
    width: 48rpx;
}

.example-content {
    flex: 1;
}

.word-main {
    gap: 8rpx;
}

.ruby-list,.word-main {
    display: -webkit-flex;
    display: flex;
}

.ruby-list {
    flex-wrap: wrap;
    gap: 12rpx 8rpx;
}

.usage-ruby-item {
    align-items: center;
    justify-content: center;
}

.entry-actions,.usage-ruby-item {
    display: -webkit-flex;
    display: flex;
}

.entry-actions {
    justify-content: flex-end;
    margin-bottom: 28rpx;
    margin-top: -24rpx;
}

.entry-add-btn {
    background: #fff;
    border: 1rpx solid #5b72eb;
    border-radius: 24rpx;
    color: #5b72eb;
    font-size: 26rpx;
    line-height: 1;
    padding: 10rpx 20rpx;
}

.bookmark-btn {
    position: absolute;
    right: 40rpx;
    top: 40rpx;
}

.bookmark-icon {
    height: 48rpx;
    width: 48rpx;
}

