page {
    background-color: #f8f9fa;
    flex-direction: column;
    height: 100%;
}

.container,page {
    display: -webkit-flex;
    display: flex;
    overflow-x: hidden;
}

.container {
    box-sizing: border-box;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    padding-bottom: 260rpx;
    width: 100%;
}

.tag-list {
    display: -webkit-flex;
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin: 24rpx 24rpx 8rpx;
}

.tag-chip {
    background: rgba(15,118,110,.12);
    border-radius: 999rpx;
    color: #0f766e;
    font-size: 24rpx;
    padding: 6rpx 18rpx;
}

.article {
    background: transparent;
    border-radius: 0;
    box-shadow: none;
    flex: 1;
    margin: 12rpx 0 0;
    overflow: hidden;
}

.article,.content {
    box-sizing: border-box;
    width: 100%;
}

.content {
    color: #1a1a1a;
    line-height: 1.8;
    padding: 8rpx 12rpx 128rpx;
}

.article-head {
    border-bottom: 2rpx solid rgba(15,23,42,.06);
    margin: 0 12rpx 24rpx;
    padding: 8rpx 4rpx 18rpx;
}

.article-head__title {
    color: #111827;
    font-size: 40rpx;
    font-weight: 700;
    line-height: 1.45;
    word-break: break-word;
}

.article-head__subtitle {
    color: #6b7280;
    font-size: 26rpx;
    line-height: 1.7;
    margin-top: 10rpx;
    word-break: break-word;
}

.paragraph {
    border-left: 4rpx solid transparent;
    color: #1a1a1a;
    font-size: 40rpx;
    font-weight: 400;
    letter-spacing: 1rpx;
    line-height: 2.6;
    margin-bottom: 32rpx;
    padding: 18rpx 14rpx;
    position: relative;
    text-align: left;
    transition: all .3s ease;
}

.paragraph:last-child {
    margin-bottom: 0;
}

.paragraph:not(:last-child)::after {
    background: linear-gradient(90deg,transparent,rgba(0,0,0,.05),transparent);
    border-radius: 999rpx;
    bottom: -12rpx;
    content: "";
    height: 2rpx;
    left: 12rpx;
    position: absolute;
    right: 12rpx;
}

.active {
    background: #f4f7ff;
    border-left: 4rpx solid #597ef7;
    box-shadow: 0 4rpx 16rpx rgba(30,60,160,.08);
    color: #151515;
    font-weight: 500;
}

.paragraph--compact {
    line-height: 2.25;
    margin-bottom: 24rpx;
    padding: 14rpx 12rpx;
}

.paragraph--compact:not(:last-child)::after {
    bottom: -8rpx;
}

.mandarin {
    color: #5f6368;
    font-size: 28rpx;
    line-height: 1.8;
    margin-top: 12rpx;
}

.article-empty {
    color: #94a3b8;
    font-size: 28rpx;
    padding: 96rpx 24rpx 300rpx;
    text-align: center;
}

