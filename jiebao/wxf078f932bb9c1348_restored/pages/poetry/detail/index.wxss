page {
    background: radial-gradient(circle at top,hsla(37,51%,68%,.18),transparent 32%),linear-gradient(180deg,#f7f2ea,#f9f7f2 36%,#f4f6fb);
    min-height: 100%;
    overflow-x: hidden;
}

.container {
    padding-bottom: 260rpx;
}

.article,.container,.content {
    box-sizing: border-box;
    width: 100%;
}

.content {
    color: #1f2937;
    padding: 18rpx 22rpx 120rpx;
}

.poetry-hero {
    border-bottom: 1rpx solid hsla(33,41%,59%,.16);
    margin: 2rpx 0 20rpx;
    padding: 10rpx 0 16rpx;
}

.poetry-hero__source {
    color: #9a7b54;
    font-size: 22rpx;
    letter-spacing: 3rpx;
    margin-bottom: 6rpx;
    text-align: center;
}

.poetry-hero__title {
    color: #2a2118;
    font-size: 46rpx;
    font-weight: 600;
    letter-spacing: 4rpx;
    line-height: 1.28;
    text-align: center;
}

.poetry-hero__title-rich {
    display: -webkit-flex;
    display: flex;
    flex-wrap: wrap;
    gap: 2rpx;
    justify-content: center;
    margin-bottom: 10rpx;
}

.poetry-hero__meta {
    color: #7b654d;
    font-size: 24rpx;
    letter-spacing: 1rpx;
    line-height: 1.55;
    margin-top: 8rpx;
    text-align: center;
}

.poetry-hero__meta-rich {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    gap: 18rpx;
    margin-top: 16rpx;
}

.poetry-hero__meta-line {
    display: -webkit-flex;
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    justify-content: center;
}

.poetry-hero__intro {
    color: #6b7280;
    font-size: 24rpx;
    line-height: 1.7;
    margin-top: 10rpx;
    text-align: center;
}

.episode-inline {
    align-items: center;
    border-bottom: 1rpx solid hsla(33,41%,59%,.14);
    display: -webkit-flex;
    display: flex;
    gap: 16rpx;
    justify-content: space-between;
    margin: 0 0 20rpx;
    padding: 0 4rpx 10rpx;
}

.episode-inline__label {
    color: #5f4731;
    font-size: 25rpx;
    font-weight: 500;
}

.episode-inline__meta {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    gap: 10rpx;
}

.episode-inline__count {
    color: #8a7a69;
    font-size: 22rpx;
}

.poetry-body {
    padding: 6rpx 0 12rpx;
}

.paragraph {
    color: #2b2118;
    font-size: 40rpx;
    font-weight: 500;
    letter-spacing: 2rpx;
    line-height: 2.05;
    margin: 0;
    padding: 12rpx 0 20rpx;
    position: relative;
    text-align: center;
    transition: all .28s ease;
}

.paragraph:not(:last-child) {
    margin-bottom: 10rpx;
}

.active {
    color: #23170f;
}

.active::after {
    background: linear-gradient(90deg,rgba(176,131,87,.08),rgba(176,131,87,.56),rgba(176,131,87,.08));
    border-radius: 999rpx;
    bottom: 8rpx;
    content: "";
    height: 6rpx;
    left: 50%;
    position: absolute;
    transform: translateX(-50%);
    width: 164rpx;
}

.paragraph--compact {
    line-height: 1.9;
    padding: 10rpx 0 16rpx;
}

.mandarin {
    color: #7a7f89;
    font-size: 24rpx;
    letter-spacing: 1rpx;
    line-height: 1.55;
    margin-top: 2rpx;
}

.article-empty {
    color: #9aa1ad;
    font-size: 28rpx;
    padding: 80rpx 24rpx 300rpx;
    text-align: center;
}

