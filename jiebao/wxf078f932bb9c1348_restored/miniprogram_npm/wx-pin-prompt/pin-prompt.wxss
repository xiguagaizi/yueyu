.container {
    align-items: flex-end;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    position: fixed;
    right: 0;
    top: 0;
    width: 600rpx;
    z-index: 10001;
}

.arrow {
    border: 10px solid transparent;
    border-bottom-color: #fff;
    height: 0;
    margin-right: 30px;
    width: 0;
}

.page {
    min-height: 40px;
}

.bar {
    background: #fff;
    border-radius: 8px;
    padding: 4px 8px;
}

.bar .text {
    color: #000;
    font-size: 12px;
    font-weight: 400;
}

.card {
    background-color: #fff;
    border-radius: 16px;
    box-shadow: 0 10rpx 20rpx -10rpx #fff;
    box-sizing: border-box;
    flex-direction: column;
    min-width: 200rpx;
    padding: 24px;
}

.card,.card .step {
    display: -webkit-flex;
    display: flex;
}

.card .step {
    align-items: flex-start;
    flex-direction: row;
    font-size: 14px;
    justify-items: start;
    padding: 8px 0;
    width: 100%;
}

.card .label {
    background: #f18282;
    border-radius: 100%;
    font-size: 12px;
    height: 20px;
    line-height: 20px;
    margin-right: 8px;
    min-height: 20px;
    min-width: 20px;
    text-align: center;
    width: 20px;
}

.card .step-1__desc {
    display: -webkit-flex;
    display: flex;
}

.card .image,.quick-entry {
    border-radius: 8px;
    margin-top: 4px;
}

.quick-entry {
    background: #444158;
    color: #fff;
    height: 70px;
    padding: 8px 16px;
    position: relative;
}

.quick-entry .quick-entry-title {
    color: gray;
    font-size: 10px;
}

.quick-entry .mini-app {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    width: 45px;
}

.quick-entry .mini-app .logo {
    border-radius: 100%;
    height: 30px;
    margin-top: 8px;
    width: 30px;
}

.quick-entry .mini-app .name {
    color: #fff;
    font-size: 8px;
    margin-top: 4px;
    text-align: center;
}

.tail {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    padding: 8px 0;
    text-align: center;
    width: 100%;
}

.got-it {
    background: transparent;
    border: 1px solid #fff;
    border-radius: 1000px;
    color: #fff;
    width: 80px;
}

.backdrop {
    background: rgba(0,0,0,.5);
    bottom: 0;
    left: 0;
    position: fixed;
    right: 0;
    top: 0;
    z-index: 10000;
}

