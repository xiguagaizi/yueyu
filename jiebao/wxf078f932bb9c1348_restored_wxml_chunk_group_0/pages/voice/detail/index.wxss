page {
    background-color: #f8f9fa;
    height: auto;
}

.container {
    box-sizing: border-box;
    margin-bottom: 50%;
    min-height: 100vh;
    padding: 40rpx 0rpx;
}

.article {
    margin-bottom: 40rpx;
    padding: 48rpx 0rpx;
}

.content {
    color: #1a1a1a;
    line-height: 1.8;
}

.paragraph {
    border-left: 4rpx solid transparent;
    color: #2c2c2c;
    font-family: "Source Han Serif CN",serif;
    font-size: 44rpx;
    font-weight: 400;
    letter-spacing: 2rpx;
    line-height: 2.2;
    margin-bottom: 48rpx;
    padding: 20rpx;
    position: relative;
    text-align: left;
    transition: all .3s ease;
}

.paragraph:last-child {
    margin-bottom: 0;
}

.paragraph:not(:last-child)::after {
    background: linear-gradient(90deg,transparent,#e0e0e0,transparent);
    bottom: -24rpx;
    content: "";
    height: 1rpx;
    left: 0;
    position: absolute;
    right: 0;
}

.active {
    background: rgba(0,0,0,.05);
    border-left: 4rpx solid #333;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06);
    color: #000;
    font-weight: 500;
}

.bottom-player-bar {
    background: #fff;
    border-top: 1rpx solid #f0f0f0;
    bottom: 0;
    box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.08);
    justify-content: space-between;
    left: 0;
    padding: 24rpx 32rpx;
    position: fixed;
    right: 0;
    z-index: 100;
}

.bottom-player-bar,.player-controls {
    align-items: center;
    display: -webkit-flex;
    display: flex;
}

.player-controls {
    flex: 1;
    gap: 24rpx;
}

.play-btn {
    align-items: center;
    background: #f8f9fa;
    border-radius: 50%;
    display: -webkit-flex;
    display: flex;
    height: 80rpx;
    justify-content: center;
    transition: all .3s ease;
    width: 80rpx;
}

.play-btn:active {
    background: #e9ecef;
    transform: scale(.95);
}

.play-info {
    flex: 1;
    flex-direction: column;
}

.play-count,.play-info {
    display: -webkit-flex;
    display: flex;
    gap: 8rpx;
}

.play-count {
    align-items: center;
}

.play-count,.play-count text {
    color: #999;
    font-size: 24rpx;
}

.duration {
    color: #333;
    font-size: 28rpx;
    font-weight: 500;
}

.action-buttons {
    gap: 32rpx;
}

.action-btn,.action-buttons {
    display: -webkit-flex;
    display: flex;
}

.action-btn {
    align-items: center;
    border-radius: 8rpx;
    flex-direction: column;
    gap: 10rpx;
    padding: 8rpx;
    transition: all .3s ease;
}

.action-btn:active {
    background: #f8f9fa;
    transform: scale(.95);
}

.action-text {
    color: #666;
    font-size: 20rpx;
}

.reset-btn {
    background-color: initial;
    border-radius: 0;
    line-height: inherit;
    margin: 0;
    padding: 0;
}

.reset-btn::after {
    border: none;
}

.setting-container {
    padding: 20rpx;
}

.setting-item {
    align-items: center;
    border-bottom: 1rpx solid #efefef;
    display: -webkit-flex;
    display: flex;
    justify-content: space-between;
    padding-bottom: 20rpx;
    padding-top: 20rpx;
}

.setting-item .desc {
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
}

.setting-item .desc text:first-child {
    font-size: 30rpx;
    font-weight: 700;
}

.setting-item .desc text:last-child {
    font-size: 24rpx;
}

