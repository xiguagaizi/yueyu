.episode-popup {
    backdrop-filter: blur(12rpx);
    background: hsla(0,0%,100%,.9);
    box-sizing: border-box;
    min-height: 100vh;
    padding: 48rpx 32rpx;
    width: 70vw;
}

.episode-popup__header {
    align-items: flex-start;
    display: -webkit-flex;
    display: flex;
    justify-content: space-between;
    margin-bottom: 24rpx;
}

.episode-popup__title {
    color: #111827;
    font-size: 34rpx;
    font-weight: 600;
}

.episode-popup__subtitle {
    display: block;
    margin-top: 4rpx;
}

.episode-popup__count,.episode-popup__subtitle {
    color: #6b7280;
    font-size: 24rpx;
}

.episode-popup__list {
    max-height: calc(100vh - 180rpx);
}

.episode-card {
    background: hsla(0,0%,100%,.95);
    border: 1rpx solid rgba(226,232,240,.9);
    border-radius: 18rpx;
    box-shadow: 0 4rpx 14rpx rgba(15,23,42,.06);
    margin-bottom: 16rpx;
    padding: 22rpx 28rpx;
    transition: all .2s ease;
}

.episode-card--active {
    background: linear-gradient(135deg,rgba(89,126,247,.12),hsla(0,0%,100%,.9));
    border-color: rgba(89,126,247,.6);
    box-shadow: 0 10rpx 20rpx rgba(89,126,247,.25);
}

.episode-card__title {
    color: #101828;
    font-size: 32rpx;
    font-weight: 600;
}

.episode-card__meta {
    color: #5b6472;
    display: -webkit-flex;
    display: flex;
    font-size: 24rpx;
    gap: 16rpx;
    margin-top: 12rpx;
}

.episode-card__badge {
    background: rgba(72,201,145,.2);
    border-radius: 999rpx;
    color: #118a4d;
    padding: 2rpx 10rpx;
}

