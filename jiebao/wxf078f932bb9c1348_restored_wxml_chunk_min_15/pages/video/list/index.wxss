.container {
    padding-bottom: 48rpx;
}

.episode-item {
    align-items: center;
    background: #fff;
    border-radius: 20rpx;
    box-shadow: 0 8rpx 24rpx rgba(15,23,42,.08);
    display: -webkit-flex;
    display: flex;
    justify-content: space-between;
    margin: 20rpx 24rpx;
    padding: 32rpx 28rpx;
    position: relative;
}

.episode-item--locked {
    border: 1px solid rgba(255,154,60,.24);
}

.episode-item--unlocked {
    background: linear-gradient(180deg,#fffdf7,#fff);
    border: 1px solid rgba(217,119,6,.18);
    box-shadow: 0 12rpx 28rpx rgba(217,119,6,.1);
}

.episode-item--locked .episode-item__summary,.episode-item--locked .episode-item__title {
    color: #94a3b8;
}

.episode-item__content {
    flex: 1;
    min-width: 0;
}

.episode-item--locked .episode-item__content,.episode-item--unlocked .episode-item__content {
    padding-right: 176rpx;
}

.episode-item__headline {
    gap: 12rpx;
    justify-content: space-between;
}

.episode-item__headline,.episode-item__play__content {
    align-items: center;
    display: -webkit-flex;
    display: flex;
}

.episode-item__play__content {
    flex-direction: column;
    gap: 10rpx;
    justify-content: center;
    min-width: 88rpx;
}

.episode-item__title {
    color: #0f172a;
    flex: 1;
    font-size: 32rpx;
    font-weight: 600;
    min-width: 0;
}

.episode-item__corner-badge {
    border-radius: 999rpx;
    font-size: 20rpx;
    font-weight: 600;
    line-height: 1;
    padding: 8rpx 14rpx;
    pointer-events: none;
    position: absolute;
    right: 12rpx;
    top: 12rpx;
    z-index: 1;
}

.episode-item__corner-badge--locked {
    background: rgba(255,154,60,.14);
    color: #c96a00;
}

.episode-item__corner-badge--unlocked {
    background: linear-gradient(135deg,rgba(255,236,179,.92),rgba(255,247,217,.96));
    box-shadow: inset 0 0 0 1rpx rgba(217,119,6,.14);
    color: #b45309;
}

.episode-item__meta {
    color: #64748b;
    display: -webkit-flex;
    display: flex;
    flex-wrap: wrap;
    font-size: 24rpx;
    gap: 12rpx;
    margin-bottom: 12rpx;
    margin-top: 12rpx;
}

.episode-item__summary {
    color: #475569;
    font-size: 26rpx;
    line-height: 1.5;
}

.episode-item__tags {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    flex-wrap: wrap;
    gap: 10rpx;
    margin-top: 10rpx;
}

.episode-item__meta-tag {
    border: none!important;
    border-radius: 999rpx!important;
    font-size: 20rpx!important;
    line-height: 1.2!important;
    opacity: .92;
    padding: 6rpx 12rpx!important;
    pointer-events: none;
}

.episode-item__meta-tag--tag {
    background: rgba(148,163,184,.12)!important;
    color: #64748b!important;
}

.episode-item__meta-tag--recent {
    background: rgba(255,247,237,.96)!important;
    border: 1rpx solid rgba(251,146,60,.2)!important;
    box-shadow: 0 2rpx 8rpx rgba(251,146,60,.08);
    color: #b45309!important;
    font-weight: 600!important;
}

.episode-item__meta-tag--upcoming {
    background: rgba(255,251,235,.98)!important;
    border: 1rpx solid rgba(245,158,11,.18)!important;
    box-shadow: 0 2rpx 8rpx rgba(245,158,11,.06);
    color: #b45309!important;
    font-weight: 600!important;
}

.episode-item__meta-tag--speech-rate {
    background: rgba(13,148,136,.1)!important;
    color: #0f766e!important;
}

.episode-item__duration {
    color: #475569;
    font-size: 22rpx;
    line-height: 1.2;
    text-align: center;
}

.episode-item__play {
    flex-shrink: 0;
}

.episode-item__duration--locked {
    color: #c96a00;
    font-weight: 600;
}

.episode-item__duration--unlocked {
    color: #b45309;
    font-weight: 600;
}

.next {
    margin: 32rpx 24rpx;
}

.loadmore {
    background: linear-gradient(135deg,#5a7dff,#8ca6ff);
    border: none;
}

.no-more {
    color: #94a3b8;
    font-size: 24rpx;
    margin-top: 24rpx;
    text-align: center;
}

.no-more text {
    display: inline-block;
    padding: 12rpx 24rpx;
}

.tag-filter {
    padding: 16rpx 0;
}

.tag-filter__scroll {
    padding: 0 24rpx;
    white-space: nowrap;
}

.tag-chip-filter {
    align-items: center;
    background: rgba(89,126,247,.12);
    border-radius: 999rpx;
    color: #1a3d99;
    display: -webkit-inline-flex;
    display: inline-flex;
    font-size: 24rpx;
    margin-right: 12rpx;
    padding: 10rpx 20rpx;
}

.tag-chip-filter text {
    color: #64748b;
    font-size: 20rpx;
    margin-left: 6rpx;
}

.tag-chip--active {
    background: #597ef7;
    color: #fff;
}

