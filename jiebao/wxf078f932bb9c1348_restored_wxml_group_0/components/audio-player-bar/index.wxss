.player-bar {
    backdrop-filter: blur(18rpx);
    background: hsla(0,0%,100%,.94);
    border-radius: 30rpx;
    bottom: 36rpx;
    bottom: calc(constant(safe-area-inset-bottom) + 36rpx);
    bottom: calc(env(safe-area-inset-bottom) + 36rpx);
    box-shadow: 0 18rpx 44rpx rgba(15,23,42,.18);
    display: block;
    left: 24rpx;
    padding: 22rpx 18rpx 22rpx 20rpx;
    position: fixed;
    right: 24rpx;
    z-index: 130;
}

.player-bar--disabled {
    opacity: .92;
}

.player-bar__body {
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    gap: 14rpx;
    min-width: 0;
}

.player-bar__top {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    gap: 16rpx;
}

.player-bar__title {
    color: #111827;
    flex: 1;
    font-size: 30rpx;
    font-weight: 600;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.player-bar__actions {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    flex-shrink: 0;
    gap: 10rpx;
}

.player-bar__action {
    background: rgba(226,232,240,.65);
    border-radius: 20rpx;
    height: 68rpx;
    width: 68rpx;
}

.player-bar__action,.player-bar__button {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    justify-content: center;
}

.player-bar__button {
    background: linear-gradient(135deg,#0f766e,#155eef);
    border-radius: 28rpx;
    box-shadow: 0 12rpx 24rpx rgba(21,94,239,.28);
    flex-shrink: 0;
    height: 92rpx;
    width: 92rpx;
}

.player-bar__button--active {
    background: linear-gradient(135deg,#0f766e,#0f9b8e);
}

.player-bar__button--disabled {
    background: linear-gradient(135deg,#94a3b8,#cbd5e1);
    box-shadow: none;
}

.player-bar__progress-block {
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0;
}

.player-bar__slider-row {
    padding: 0 18rpx 24rpx;
}

.player-bar__slider {
    box-sizing: border-box;
    width: 100%;
}

.player-bar__time-row {
    align-items: center;
    display: grid;
    gap: 16rpx;
    grid-template-columns: 1fr auto 1fr;
    min-height: 28rpx;
    padding: 0 18rpx;
}

.player-bar__time {
    color: #7b8798;
    font-size: 20rpx;
    line-height: 28rpx;
}

.player-bar__time--end {
    justify-self: end;
}

.player-bar__time-center {
    display: -webkit-flex;
    display: flex;
    min-height: 38rpx;
    min-width: 0;
}

.player-bar__loop-progress,.player-bar__time-center {
    align-items: center;
    justify-content: center;
}

.player-bar__loop-progress {
    background: hsla(48,97%,77%,.45);
    border-radius: 999rpx;
    display: -webkit-inline-flex;
    display: inline-flex;
    flex-shrink: 0;
    height: 38rpx;
    padding: 0 16rpx;
    white-space: nowrap;
}

.player-bar__loop-progress-text {
    color: #b45309;
    font-size: 22rpx;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
}

.player-bar__desc {
    color: #667085;
    font-size: 23rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

