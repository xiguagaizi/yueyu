.container {
    background: #f7f8fa;
    min-height: 100vh;
    padding: 24rpx;
}

.header {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
}

.vip-icon {
    height: 96rpx;
    margin-bottom: 24rpx;
    width: 96rpx;
}

.title {
    color: #323233;
    font-size: 40rpx;
    font-weight: 600;
    margin-bottom: 12rpx;
}

.subtitle {
    color: #969799;
    font-size: 28rpx;
}

.plans {
    margin: 22rpx 0;
}

.plan-item {
    background: #fff;
    border: 2rpx solid transparent;
    border-radius: 12rpx;
    margin-bottom: 20rpx;
    overflow: hidden;
    padding: 20rpx;
    position: relative;
    transition: all .3s ease;
}

.plan-item.active {
    background: #fff5f5;
    border-color: #ff6b6b;
}

.plan-tag {
    background: #ff6b6b;
    border-radius: 8rpx 0 8rpx 0rpx;
    bottom: 0;
    color: #fff;
    font-size: 24rpx;
    padding: 4rpx 16rpx;
    position: absolute;
    right: 0;
}

.plan-content {
    flex-direction: column;
    gap: 8rpx;
}

.plan-content,.plan-header {
    display: -webkit-flex;
    display: flex;
}

.plan-header {
    align-items: center;
    justify-content: space-between;
}

.plan-title {
    color: #323233;
    font-size: 32rpx;
    font-weight: 500;
}

.plan-price {
    color: #ff6b6b;
    font-size: 40rpx;
    font-weight: 600;
}

.price-wrap {
    align-items: baseline;
    display: -webkit-flex;
    display: flex;
    gap: 8rpx;
}

.original-price {
    color: #969799;
    font-size: 26rpx;
    text-decoration: line-through;
}

.plan-desc {
    color: #969799;
    font-size: 24rpx;
}

.check-icon {
    color: #ff6b6b;
    position: absolute;
    right: 32rpx;
    top: 50%;
    transform: translateY(-50%);
}

.benefits {
    background: #fff;
    border-radius: 12rpx;
    margin-bottom: 32rpx;
    padding: 32rpx;
}

.benefit-item {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    gap: 16rpx;
    margin-bottom: 16rpx;
}

.benefit-item:last-child {
    margin-bottom: 0;
}

.benefit-item text {
    color: #323233;
    font-size: 28rpx;
}

.footer {
    padding: 32rpx 0;
}

.agreement {
    color: #969799;
    display: -webkit-flex;
    display: flex;
    font-size: 26rpx;
    gap: 18rpx;
    justify-content: center;
    margin-top: 22rpx;
}

.link {
    color: orange;
}

