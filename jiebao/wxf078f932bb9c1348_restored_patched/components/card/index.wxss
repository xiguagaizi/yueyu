.container {
    border-radius: 10px;
    box-shadow: 2px 2px 5px #dbdada;
    height: 120px;
    position: relative;
    width: 100%!important;
}

.title {
    color: #fff;
    font-size: 20px;
    left: 20px;
    top: 20px;
}

.logo,.title {
    position: absolute;
}

.logo {
    bottom: 10px;
    height: 50px;
    opacity: .7;
    right: 10px;
    width: 50px;
}

