page {
    height: auto;
}

.custom-nav {
    background-color: #fff!important;
}

.container {
    box-sizing: border-box;
    padding: 20rpx 20rpx 100px;
}

.container,.message-item {
    flex-direction: column;
}

.container,.message-item,.time {
    display: -webkit-flex;
    display: flex;
}

.time {
    color: #cecaca;
    font-size: 24rpx;
    justify-content: center;
}

.item {
    align-items: flex-start;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    justify-content: flex-start;
    margin-bottom: 40rpx;
}

.right {
    flex-direction: row-reverse;
}

.item .avartor {
    background-color: gray;
    border-radius: 50%;
    height: 100rpx;
    width: 100rpx;
}

.item .avartor image {
    border-radius: 50%;
    height: 100%;
    width: 100%;
}

.item .content-container {
    margin-left: 20rpx;
    max-width: 460rpx;
    min-width: 120rpx;
}

.right .content-container {
    margin-left: auto;
    margin-right: 20rpx;
}

.item .content-container .text {
    background-color: #a6ed8e;
    border-radius: 10rpx;
    color: #333;
    line-height: 150%;
    padding: 20rpx;
}

.item .content-container .audio {
    align-items: center;
    background-color: #a6ed8e;
    border-radius: 10rpx;
    display: -webkit-flex;
    display: flex;
    margin-left: 10rpx;
    min-width: 120rpx;
    padding: 20rpx;
}

.right .content-container .audio,.right .content-container .text {
    background-color: #fff;
}

.item .content-container .audio text {
    color: #666;
    font-size: 30rpx;
    margin-left: 10rpx;
}

.footer {
    align-items: flex-start;
    background-color: #f6f6f6;
    bottom: 0;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    height: 180rpx;
    justify-content: center;
    left: 0;
    position: fixed;
    width: 100%;
    z-index: 999;
}

.footer .tips {
    color: #666;
    font-size: 24rpx;
    margin-bottom: 10rpx;
    padding-left: 30rpx;
    width: 100%;
}

.footer .btn {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    justify-content: flex-start;
    width: 100%;
}

.footer van-button {
    margin-left: 20rpx;
}

.text-form {
    background-color: red;
    height: 100%;
}

.video-form {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: center;
}

.record-btn {
    font-size: 50rpx;
}

.form-panel {
    height: 100%;
    justify-content: space-between;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 30px;
    width: 100%;
}

.form-panel,.main {
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
}

.main {
    justify-content: flex-start;
}

.btn-bar {
    box-sizing: border-box;
    margin-bottom: 10rpx;
    padding-left: 10px;
    padding-right: 10px;
    width: 100%;
}

.progress {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    height: 100%;
    justify-content: center;
}

.rec-tips {
    border-radius: 10rpx;
    color: #ff5126;
    font-size: 32rpx;
    margin: 15rpx;
    padding: 5rpx;
    text-align: center;
}

.tool {
    display: -webkit-flex;
    display: flex;
}

