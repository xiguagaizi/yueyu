.container {
    padding-bottom: 15px;
}

.item {
    border-bottom: 1px solid #e6e6e6;
    justify-content: space-between;
    margin: 15px;
    padding-bottom: 10px;
}

.item,.main {
    display: -webkit-flex;
    display: flex;
}

.main {
    color: #666;
    flex-direction: column;
    font-size: 14px;
    justify-content: flex-start;
}

.date-row {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    gap: 12rpx;
}

.date {
    color: #333;
    font-size: 16px;
}

.content {
    font-size: 14px;
    line-height: 150%;
}

.status {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    flex-shrink: 0;
    font-size: 14px;
    justify-content: flex-end;
    min-height: 72rpx;
    min-width: 150rpx;
}

.needvip .content,.needvip .date {
    color: #999898;
}

.vip-access-badge {
    background: #fff6df;
    border: 1rpx solid #f1d493;
    border-radius: 999rpx;
    color: #c38a24;
    font-size: 20rpx;
    justify-content: center;
    padding: 6rpx 14rpx;
}

.status-tag,.vip-access-badge {
    align-items: center;
    display: -webkit-inline-flex;
    display: inline-flex;
    font-weight: 600;
    line-height: 1;
}

.status-tag {
    border-radius: 999rpx;
    font-size: 24rpx;
    gap: 8rpx;
    padding: 10rpx 18rpx;
}

.status-tag--checked {
    background: #edf9f0;
    color: #1f9d55;
}

.status-unlock-btn {
    background: #fffaf0!important;
    border-color: #f1d493!important;
    color: #c38a24!important;
}

