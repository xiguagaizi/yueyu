<view class="comp-player-container">
	<view class="play-ctrl">
		<van-icon bind:tap="play" color="#363333" info="" infoClass="info-cls" name="play-circle-o" size="45px">		</van-icon>
	</view>
	<view class="progress">
		<view class="progress-bar">
			<view>
				<van-progress color="green" percentage="" showPivot="false" strokeWidth="2">				</van-progress>
			</view>
		</view>
		<view class="time-bar">
			<text>
				00:00
			</text>
			<text>
				00:00
			</text>
		</view>
	</view>
</view>
