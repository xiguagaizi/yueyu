.container {
    background: #f8f9fa;
    min-height: 100vh;
    padding-bottom: 40rpx;
}

.order-list {
    padding: 20rpx;
}

.empty-state {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 120rpx 0;
}

.empty-text {
    color: #999;
    font-size: 28rpx;
    margin-top: 20rpx;
}

.order-item {
    background: #fff;
    border-radius: 12rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04);
    margin-bottom: 20rpx;
    padding: 30rpx;
}

.order-header {
    align-items: center;
    border-bottom: 1rpx solid #f5f5f5;
    display: -webkit-flex;
    display: flex;
    justify-content: space-between;
    margin-bottom: 20rpx;
    padding-bottom: 20rpx;
}

.order-time {
    color: #666;
    font-size: 26rpx;
}

.order-status {
    color: #ff6b6b;
    font-size: 26rpx;
}

.order-status.success {
    color: #51cf66;
}

.goods-info {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    justify-content: space-between;
}

.goods-name {
    color: #333;
    font-size: 30rpx;
    font-weight: 500;
}

.goods-price {
    align-items: baseline;
    display: -webkit-flex;
    display: flex;
}

.currency {
    color: #333;
    font-size: 24rpx;
    margin-right: 4rpx;
}

.amount {
    color: #333;
    font-size: 32rpx;
    font-weight: 700;
}

.order-footer {
    border-top: 1rpx solid #f5f5f5;
    margin-top: 20rpx;
    padding-top: 20rpx;
}

.order-id {
    align-items: center;
    color: #999;
    display: -webkit-flex;
    display: flex;
    font-size: 24rpx;
    margin-bottom: 16rpx;
}

.copy-icon {
    color: #666;
    margin-left: 10rpx;
}

.action-buttons {
    display: -webkit-flex;
    display: flex;
    gap: 20rpx;
    justify-content: flex-end;
}

.action-btn {
    background: #fff;
    border-radius: 8rpx;
    font-size: 26rpx;
    padding: 12rpx 30rpx;
}

.pay-btn {
    background: #1989fa;
    border: none;
    color: #fff;
}

.cancel-btn {
    border: 1rpx solid #ddd;
    color: #666;
}

.custom-nav {
--nav-bar-text-color:#333;--nav-bar-icon-color:#333;--nav-bar-background-color:#fff}

.loading-more {
    color: #999;
    font-size: 26rpx;
    padding: 30rpx 0;
    text-align: center;
}

.load-more-btn {
    color: #1989fa;
}

.no-more {
    color: #999;
}

