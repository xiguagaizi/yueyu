.settings-panel {
    padding: 32rpx 32rpx 60rpx;
}

.settings-panel__title {
    color: #1a1a1a;
    font-size: 32rpx;
    font-weight: 600;
    margin-bottom: 20rpx;
}

.settings-item {
    align-items: center;
    border-bottom: 1rpx solid #f3f3f3;
    display: -webkit-flex;
    display: flex;
    justify-content: space-between;
    padding: 20rpx 0;
}

.settings-item:last-child {
    border-bottom: none;
}

.settings-item__text {
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    gap: 6rpx;
    padding-right: 24rpx;
}

.settings-item__title {
    color: #1f2937;
    font-size: 30rpx;
    font-weight: 600;
}

.settings-item__desc {
    color: #6b7280;
    font-size: 24rpx;
    line-height: 1.5;
}

