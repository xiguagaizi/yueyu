.ruby-segment {
    align-items: center;
    display: -webkit-inline-flex;
    display: inline-flex;
    flex-direction: column;
    vertical-align: top;
}

.ruby-segment__words {
    align-items: flex-end;
    display: -webkit-flex;
    display: flex;
    flex-wrap: wrap;
}

.ruby-segment__words--with-divider {
    border-bottom: 1px solid #40a798;
}

.ruby-segment__token {
    align-items: flex-end;
    display: -webkit-flex;
    display: flex;
    margin: 0 5rpx;
}

.ruby-segment__word {
    align-items: center;
    display: -webkit-flex;
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1.2;
}

.ruby-segment__annotation {
    color: #40a798;
    font-size: 28rpx;
    font-weight: 350;
    line-height: 1.6;
    margin-bottom: 20rpx;
}

.ruby-segment__punctuation {
    align-items: flex-end;
    color: #2c2c2c;
    display: -webkit-flex;
    display: flex;
    font-size: 32rpx;
    line-height: 1.2;
    padding-left: 4rpx;
    padding-right: 4rpx;
}

.ruby-segment__punctuation--prefix {
    margin-right: 2rpx;
    transform: translateY(-20rpx);
}

.ruby-segment__punctuation--suffix {
    margin-left: 2rpx;
    transform: translateY(-20rpx);
}

.ruby-segment--hero-title .ruby-segment__token {
    margin: 0 2rpx;
}

.ruby-segment--subtitle-compact .ruby-segment__token {
    margin: 0 4rpx;
}

.ruby-segment--subtitle-compact .ruby-segment__punctuation {
    font-size: 28rpx;
    transform: translateY(-16rpx);
}

.ruby-segment--hero-title .ruby-segment__punctuation {
    font-size: 38rpx;
    transform: translateY(-12rpx);
}

.ruby-segment--hero-meta .ruby-segment__token {
    margin: 0 8rpx;
}

.ruby-segment--hero-meta .ruby-segment__punctuation {
    font-size: 26rpx;
    transform: translateY(-10rpx);
}

