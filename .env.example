# 复制成 .env 再填，服务端读取，不会暴露给浏览器
CANTONESE_AI_API_KEY=

# 听力训练：服务端专用的阿里云百炼凭据，不会暴露给浏览器
DASHSCOPE_API_KEY=
# 填写与你的 API Key 地域匹配的 OpenAI 兼容地址，并替换真实 WorkspaceId。
# 如账户仍使用旧版入口，也可填控制台提供的 dashscope 兼容地址。
DASHSCOPE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 短录音直接用 Base64 提交，无需将个人录音上传到公开文件服务器
LISTENING_ASR_MODEL=qwen3-asr-flash
# 固定快照版，避免模型更新造成评分规则漂移
LISTENING_GRADE_MODEL=qwen3.7-plus-2026-05-26

# 示范音频/课文所在目录（默认就是下面这个）
LESSON_DIR=D:\粤语打卡\小打卡任务

# 只换示范音频目录（不填就跟 LESSON_DIR 一样）
# 例如用 scripts/trim-audio.mjs 裁掉开场白后的副本：
# AUDIO_DIR=D:\粤语打卡\小打卡任务\去掉开场白

# 新合集 resource/<日期>/ 下的原速与慢速音频目录
RESOURCE_DIR=/home/ubuntu/yueyu/resource

# MySQL（npm run db:setup 会创建 mcdb/mcapp 并自动写入实际密码）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mcdb
DB_USER=mcapp
DB_PASSWORD=
# DB_CONNECTION_LIMIT=10
# 需要远程连接时执行：sudo env DB_REMOTE_HOST=% node scripts/setup-mysql.mjs
# DB_REMOTE_HOST=%

# 录音实体文件目录；MySQL 只保存相对于该目录的文件映射
# RECORDING_DIR=/home/ubuntu/yueyu/recordings

# 本地端口
PORT=5178
